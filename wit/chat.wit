package local:agent@0.1.0;

interface chat-api {
    use types.{chat-request, chat-stream};

    chat: async func(request: chat-request) -> chat-stream;

    // Generic dispatch to whatever tool the host has loaded under `name` --
    // the agent never knows what a tool actually does, just that calling it
    // by name with a JSON input string produces a JSON/text result string.
    call-tool: func(name: string, input: string) -> result<string, string>;
}

world chat-guest {
    import chat-api;
    import session;
    import run-events;
    export agent-api;
}

// Structured execution, independent of terminal input/output.
interface agent-api {
    run-turn: async func(prompt: string) -> result<_, string>;
}

interface run-events {
    record usage {
        reasoning-tokens: option<u32>,
        max-tokens: u32,
        prompt-tokens: option<u32>,
        cache-read-tokens: option<u32>,
        cache-creation-tokens: option<u32>,
    }
    variant event {
        text(string),
        usage(usage),
    }
    emit: func(value: event);
}
