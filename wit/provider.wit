package local:agent@0.1.0;

interface provider-api {
    use types.{chat-request, chat-stream};

    record tool-definition {
        name: string,
        description: string,
        input-schema-json: string,
    }

    // Translates one `chat-request` into this provider's native API call and
    // back. `model` and `tools` come from the host's agent definition.
    // Credentials never cross this boundary: the host adds them as headers
    // to the provider's outbound requests (see `headers` in the config).
    chat: async func(
        model: string,
        tools: list<tool-definition>,
        request: chat-request,
    ) -> chat-stream;
}

world provider-guest {
    export provider-api;
}
