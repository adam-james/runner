package local:agent@0.1.0;

// The types of a `chat` call, shared by the agent (via `chat-api`) and
// providers (via `provider-api`). Kept in their own type-only interface so a
// provider can use them without also importing `chat-api`'s functions.
interface types {
    use messages.{message, content-block};

    // Deliberately has no `provider`/`model` field: which provider and model
    // actually serve a `chat` call is host configuration, not something the
    // guest states or can override. Any guest component works unmodified
    // against whatever provider the host is configured for.
    record chat-request {
        system: option<string>,
        max-tokens: u32,
        messages: list<message>,
    }

    record chat-response {
        content: list<content-block>,
        stop-reason: option<string>,
        // Tokens the model spent reasoning before replying, which count
        // toward `max-tokens` but aren't in `content`. None if the provider
        // doesn't report it.
        reasoning-tokens: option<u32>,
    }

    record api-error-detail {
        status: u16,
        body: string,
    }

    variant chat-error {
        invalid-request(string),
        network(string),
        api(api-error-detail),
        internal(string),
    }

    // A reply in progress. `text` yields pieces of the reply's text as the
    // model generates them, for display only; `response` resolves once the
    // reply is complete, with the whole thing (all text, tool calls, stop
    // reason) or the error that cut it short.
    record chat-stream {
        text: stream<string>,
        response: future<result<chat-response, chat-error>>,
    }
}
